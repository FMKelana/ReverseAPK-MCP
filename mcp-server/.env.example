# Repository root. Leave empty to auto-detect it from the installed package location.
# Set this when the server is started from a different working directory.
REVERSEAPK_HOME=

# Maximum number of bytes of tool output returned to the agent. The rest is
# truncated and written to a log file inside the session workspace.
REVERSEAPK_MAX_OUTPUT_BYTES=64000

# Default timeout per job, in seconds.
REVERSEAPK_DEFAULT_TIMEOUT=600

# Log level: DEBUG, INFO, WARNING, ERROR
REVERSEAPK_LOG_LEVEL=INFO
